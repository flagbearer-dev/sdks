# Packagist publishes the PHP SDK from this repository's root composer.json and
# its vX.Y.Z tags. Composer downloads each version as a GitHub archive, so
# everything but the PHP SDK is left out of archives. Add new top-level
# folders here too.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/README.md export-ignore
/bun.lock export-ignore
/package.json export-ignore
/cpp export-ignore
/dotnet export-ignore
/fixtures export-ignore
/go export-ignore
/java export-ignore
/js export-ignore
/python export-ignore
/ruby export-ignore
/rust export-ignore
/scripts export-ignore
/testing export-ignore
/php/tests export-ignore
/php/composer.json export-ignore
/php/composer.lock export-ignore
/php/package.json export-ignore
/php/phpstan.neon export-ignore
/php/phpunit.xml export-ignore
