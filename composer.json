{
  "name": "flagbearer/flagbearer",
  "description": "Flagbearer PHP SDK: check feature flags locally, with rules cached between requests.",
  "type": "library",
  "license": "MIT",
  "keywords": ["feature-flags", "flagbearer"],
  "homepage": "https://flagbearer.dev",
  "support": {
    "docs": "https://docs.flagbearer.dev/sdks/php",
    "source": "https://github.com/flagbearer-dev/sdks/tree/main/php"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "psr/simple-cache": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "Flagbearer\\": "php/src/"
    }
  }
}
